# Soccer Mind — public frontend configuration only.
# Copy to .env.local for local development. Do not commit .env.local.

# Local FastAPI default. The backend repo (soccer-llm-analyst) listens on :8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production MUST be HTTPS and must not fall back to localhost, for example:
# NEXT_PUBLIC_API_URL=https://YOUR_VPS_API_HOST
#
# The VPS backend must list this app's origin in CORS_ORIGINS.
# Never put OPENAI_API_KEY, YOUTUBE_API_KEY, or VPS credentials here.
